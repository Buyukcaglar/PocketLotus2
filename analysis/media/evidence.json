    "embedded_adffs_compatibility_wrapper": {
      "path": "C:\\Projects\\PocketLotus\\analysis\\media\\F1023201\\embedded_adffs_boot.obey",
      "bytes": 1427,
      "sha256": "c5c9c1a493540ac3e04ce667ae83a760ce0879e61f08f3f499b3104b6d294af5",
      "commands": [
        "ADFS",
        "SET Obey$Dir ADFS::Lotus2Dsk1.$.!LOTUS",
        "DIR <Obey$Dir>",
        "",
        "RMAFree 200",
        "IF ADFFS$OSVersion>=&35000 THEN ADFRemapVideoMemory 9 80 ELSE ScreenSize 80",
        "IF ADFFS$OSVersion<&35000 THEN echo <22><9>",
        "",
        "Set Lotu$Dir <Obey$dir>",
        "Dir <Lotu$Dir>",
        "RMAFree 200",
        "RMEnsure QTMTracker   1.43 RMLoad <ADFFS$Dir>.trackers.QTMModule",
        "RMEnsure MusicModule2 0.02 RMLoad <ADFFS$Dir>.trackers.MusMod2",
        "",
        "IF ADFFS$LCDGM=\"Y\" THEN LCDGameModes Off",
        "",
        "WimpSlot -min 540K -max 540K",
        "IF ADFFS$OSVersion>=&35000 THEN GOARM3JIT 0",
        "",
        "| Prevent IRQ / FIQ being shutdown",
        "IF ADFFS$OSVersion>=&35000 THEN JITMEMORYA 1224C E5CBE028 E1A00000",
        "IF ADFFS$OSVersion>=&35000 THEN JITMEMORYA 1225C E5CBE018 E1A00000",
        "IF ADFFS$OSVersion>=&35000 THEN JITMEMORYA 1226C E5CBE038 E1A00000",
        "IF ADFFS$OSVersion>=&35000 THEN JITMEMORYA DE30 E5CBE028 E1A00000",
        "IF ADFFS$OSVersion>=&35000 THEN JITMEMORYA DE40 E5CBE018 E1A00000",
        "IF ADFFS$OSVersion>=&35000 THEN JITMEMORYA DE50 E5CBE038 E1A00000",
        "",
        "| Prevent Channel Handler switching to IRQ CPU mode",
        "IF ADFFS$OSVersion>=&35000 THEN JITMEMORYA 11A4C E390F002 E1A0F000",
        "IF ADFFS$OSVersion>=&35000 THEN JITMEMORYA 11A50 E33FF382 E1A00000",
        "",
        "| Fix bug in code",
        "IF ADFFS$OSVersion>=&35000 THEN JITMEMORYA 11F00 E8BD9FFF E8BDDFFF",
        "",
        "<Lotu$Dir>.Loader DIS      ;",
        "",
        "IF ADFFS$OSVersion>=&35000 THEN ADFRemapVideoMemory",
        "IF ADFFS$CPUID>=&A10 THEN GOARM3JIT",
        "RMKill MusicModule2",
        "IF ADFFS$LCDGM=\"Y\" AND ADFFS$OSVersion>&31100 THEN LCDGameModes On",
        "",
        "fx 200,0",
        "",
        "Unset Lotu$Dir"
      ],
      "requests": [
        "MODE 9",
        "80 KiB screen allocation",
        "540 KiB WimpSlot",
